  "email": "juanmavillalobosn@gmail.com",
  "password": "password"
}

### Create Unvalidated User
POST localhost:8080/api/auth/register
Authorization: Bearer
Content-Type: application/json

{
  "username": "admin",
  "email": "juanmavillalobosn@gmail.com",
  "roles": ["ADMIN"]
}


